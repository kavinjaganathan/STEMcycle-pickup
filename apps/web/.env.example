# Copy to .env.local for local development. On Vercel, set these in
# Project Settings -> Environment Variables. Never commit real values.

# Public URL of the app (used in emailed cancel links)
APP_URL=http://localhost:3000

# --- Database ---------------------------------------------------------------
# Leave SUPABASE_* empty locally to use the built-in PGlite database (.data/).
# DATA_BACKEND=local|supabase  (auto: supabase when SUPABASE_URL is set)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Email ------------------------------------------------------------------
# smtp   = send through an SMTP account (Gmail: needs an App Password)
# resend = Resend API (needs a verified domain + RESEND_API_KEY)
# file   = local dev only; writes emails to .data/outbox/
# To switch the sending address later, change EMAIL_FROM (and SMTP_USER/SMTP_PASS).
EMAIL_PROVIDER=file
EMAIL_FROM=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=
RESEND_API_KEY=

# --- Spam protection ----------------------------------------------------------
# Cloudflare Turnstile. These are Cloudflare's official always-pass test keys;
# replace them with real keys in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Random secret used to hash IPs/emails for rate limiting (required in production).
# Generate with: openssl rand -hex 32
RATE_LIMIT_SALT=

# Protects /api/cron/daily (Vercel Cron sends it automatically). openssl rand -hex 32
CRON_SECRET=

# --- Routing -----------------------------------------------------------------
# Free key from https://openrouteservice.org/dev/#/signup (2,000 requests/day).
ORS_API_KEY=
# OR-Tools solver on Render. Leave empty to use the built-in fallback planner.
SOLVER_URL=
SOLVER_SECRET=
# Contact address sent to Nominatim (defaults to EMAIL_FROM).
NOMINATIM_CONTACT_EMAIL=
