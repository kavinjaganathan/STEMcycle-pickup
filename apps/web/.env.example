# Copy to .env.local for local development. On Cloudflare, public values go in
# wrangler.jsonc "vars" and secrets via `npx wrangler secret put`. Never commit real values.

# Public URL of the app (used in emailed links). Production: https://ftcoverdrive.org/STEM
APP_URL=http://localhost:3000
# Sub-path the app is served under (build time). Production: /STEM. Empty locally.
NEXT_PUBLIC_BASE_PATH=
# Shared with the ftcoverdrive.org proxy (STEMCYCLE_PROXY_SECRET) so the app can
# trust the visitor IP it forwards for rate limiting. openssl rand -hex 32
PROXY_SECRET=

# --- Database ---------------------------------------------------------------
# Leave SUPABASE_* empty locally to use the built-in PGlite database (.data/).
# DATA_BACKEND=local|supabase  (auto: supabase when SUPABASE_URL is set)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin (one shared login; there is no admin sign-up) ----------------------
# Locally these can stay empty: the admin is admin@stemcycle.local / stemcycle-admin.
# ADMIN_PASSWORD_HASH comes from: node scripts/hash-admin-password.mjs
# ADMIN_SESSION_SECRET: openssl rand -hex 32  (changing it signs the admin out everywhere)
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=

# --- Drivers ---------------------------------------------------------------
# Driver sign-up only works through the invite link shown on Admin -> Drivers
# (/signup?invite=CODE). Recommended in production. openssl rand -hex 12
# Changing it retires old links. Empty = /signup is open (admin still approves).
DRIVER_INVITE_CODE=

# --- Email ------------------------------------------------------------------
# smtp   = send through an SMTP account (Gmail: needs an App Password)
# resend = Resend API (needs a verified domain + RESEND_API_KEY)
# file   = local dev only; writes emails to .data/outbox/
# To switch the sending address later, change EMAIL_FROM (and SMTP_USER/SMTP_PASS).
EMAIL_PROVIDER=file
EMAIL_FROM=you@example.com
# Where Contact Us messages go and the address shown on /contact.
# Defaults to the reply-to address in Settings, then EMAIL_FROM.
CONTACT_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=
RESEND_API_KEY=

# --- Spam protection ----------------------------------------------------------
# Cloudflare Turnstile. These are Cloudflare's official always-pass test keys;
# replace them with real keys in production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Random secret used to hash IPs/emails for rate limiting (required in production).
# Generate with: openssl rand -hex 32
RATE_LIMIT_SALT=

# Protects /api/cron/daily and /api/internal/routing/tick (both called by pg_cron).
# openssl rand -hex 32
CRON_SECRET=

# --- Routing -----------------------------------------------------------------
# Free key from https://openrouteservice.org/dev/#/signup (2,000 requests/day).
ORS_API_KEY=
# OR-Tools solver on Render. Leave empty to use the built-in fallback planner.
SOLVER_URL=
SOLVER_SECRET=
# Automatic routing waits until a weekend has had no changes for this long.
ROUTING_QUIET_SECONDS=120
# Local dev only (no pg_cron): how often the in-process routing tick runs.
# LOCAL_ROUTING_TICK_SECONDS=30   LOCAL_ROUTING_TICK=off to disable
# Contact address sent to Nominatim (defaults to EMAIL_FROM).
NOMINATIM_CONTACT_EMAIL=
