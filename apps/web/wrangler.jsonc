{
  // StemCycle Pickup as a Cloudflare Worker, served at https://ftcoverdrive.org/STEM
  // through the team site's Worker (service binding "STEMCYCLE"). Build and deploy:
  //   npm run cf:deploy
  // Secrets (never in this file):  npx wrangler secret put <NAME>
  //   SUPABASE_ANON_KEY  SUPABASE_SERVICE_ROLE_KEY  ADMIN_PASSWORD_HASH
  //   ADMIN_SESSION_SECRET  RATE_LIMIT_SALT  CRON_SECRET  TURNSTILE_SECRET_KEY
  //   RESEND_API_KEY (or SMTP_PASS with EMAIL_PROVIDER smtp)  DRIVER_INVITE_CODE  SOLVER_SECRET  ORS_API_KEY
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stemcycle-pickup",
  // Same account as the team site (a service binding only works within one account).
  "account_id": "759eb5211e52ef3fe3371a1bdfa70566",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  // Only reachable through ftcoverdrive.org/STEM, not a separate workers.dev URL.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "APP_URL": "https://ftcoverdrive.org/STEM",
    "NEXT_PUBLIC_BASE_PATH": "/STEM",
    "DATA_BACKEND": "supabase",
    "SUPABASE_URL": "https://cqtyrccofpsvmvkdxkei.supabase.co",
    "ADMIN_EMAIL": "ftcoverdrive17294@gmail.com",
    // Sent through Resend from the verified ftcoverdrive.org domain; Contact Us
    // messages (and the address the Contact page shows) go to the team inbox.
    "EMAIL_PROVIDER": "resend",
    "EMAIL_FROM": "pickup@ftcoverdrive.org",
    "CONTACT_EMAIL": "ftcoverdrive17294@gmail.com",
    "SOLVER_URL": ""
  }
}
