    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "leaflet": "^1.9.4",
    "next": "16.4.2",
    "nodemailer": "^10.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@electric-sql/pglite": "^0.5.11",
    "@opennextjs/cloudflare": "^1.20.13",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
